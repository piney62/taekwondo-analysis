# LLM Provider Selection
# Options: gemini | claude | deepseek
LLM_PROVIDER=gemini

# Google Gemini (default — free tier during development)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (fallback / production)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek (budget option, OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
